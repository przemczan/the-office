  "skills.user-scope": {
    "win32": {
      "installedPlugins": {
        "present": true,
        "loaded": []
      },
      "skills": {
        "present": true,
        "loaded": []
      },
      "commands": {
        "present": false,
        "loaded": []
      },
      "syncedSkills": {
        "present": true,
        "loaded": []
      },
      "syncedPlugins": {
        "present": true,
        "loaded": []
      }
