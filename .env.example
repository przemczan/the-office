# Copy to .env. docker compose reads it, and the service loads it at start;
# a variable already set in the environment wins over this file.

# Postgres in docker-compose.yml, a local-only database published on 127.0.0.1.
POSTGRES_USER=office
POSTGRES_PASSWORD=office
POSTGRES_DB=the_office
POSTGRES_PORT=5432

# Grafana from grafana/otel-lgtm, at http://localhost:<GRAFANA_PORT>. Off 3000, which other
# local tools often hold.
GRAFANA_PORT=3300

# The service's port, served on 127.0.0.1 only.
OFFICE_PORT=4310

# The service's database: the Postgres above (user, password, port and database must match).
DATABASE_URL=postgres://office:office@127.0.0.1:5432/the_office

# The Office data directory (worktrees, sessions, skills, attachments); an absolute path.
# Left blank, it is %LOCALAPPDATA%\the-office on Windows and $XDG_DATA_HOME/the-office
# (or ~/.local/share/the-office) on Linux.
OFFICE_DATA_DIR=
