# Copy to .env. docker compose reads it, and the service loads it at start;
# a variable already set in the environment wins over this file.

# Postgres in docker-compose.yml, a local-only database published on 127.0.0.1.
POSTGRES_USER=office
POSTGRES_PASSWORD=office
POSTGRES_DB=the_office
POSTGRES_PORT=5432

# The bundled Grafana, grafana/otel-lgtm, at http://localhost:<GRAFANA_PORT>; docker compose
# starts it while COMPOSE_PROFILES holds grafana. Left blank, compose starts Postgres alone.
# Port 3300 is off 3000, which other local tools often hold.
COMPOSE_PROFILES=grafana
GRAFANA_PORT=3300

# The service's address and port. 127.0.0.1 serves this machine alone. To reach The Office over the
# local network, name the machine's IP address or 0.0.0.0 (every address): passwords and the sign-in
# cookie then cross it over plain HTTP, so only on a network you trust. A request must be addressed
# to localhost, an IP address or the public address below, never another name.
OFFICE_HOST=127.0.0.1
OFFICE_PORT=4310

# The public address: the https:// address, with no path, at which your reverse proxy serves
# The Office, such as https://office.example.com (docs/running-the-office.md, "Behind a reverse
# proxy"). Left blank, The Office has none.
OFFICE_PUBLIC_ADDRESS=

# The service's database: the Postgres above (user, password, port and database must match).
DATABASE_URL=postgres://office:office@127.0.0.1:5432/the_office

# The Office data directory (worktrees, sessions, skills, attachments); an absolute path.
# Left blank, it is %LOCALAPPDATA%\the-office on Windows and $XDG_DATA_HOME/the-office
# (or ~/.local/share/the-office) on Linux.
OFFICE_DATA_DIR=

# Telemetry (traces, metrics and logs over OTLP over HTTP) is chosen in First-run setup and in
# Settings › Telemetry: off, the bundled Grafana above, or your own endpoint. The standard OTEL_*
# variables win over that setting when set here, and the card then only shows them: name an OTLP
# over HTTP endpoint (for the bundled Grafana http://127.0.0.1:4318, 127.0.0.1, not localhost,
# since its ports are published on IPv4 only), its credentials in OTEL_EXPORTER_OTLP_HEADERS (such
# as Authorization=Basic <base64>) and OTEL_EXPORTER_OTLP_TIMEOUT in milliseconds; or set
# OTEL_SDK_DISABLED=true to send nowhere.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# An automated install sets this to true to leave out First-run setup's basics (the engine,
# Sign in with GitHub, telemetry); the setup token and the first user are still asked for.
OFFICE_SKIP_SETUP_BASICS=false
