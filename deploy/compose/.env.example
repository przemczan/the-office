# The Compose install's settings, read by docker-compose.yml beside it. Set them here, never in the
# shell: a shell variable would win over this file, and the Office updater wouldn't see it.
#
# First run, in this folder:
#   chmod 600 .env                 (it holds the database's password)
#   docker compose up -d
#   docker compose logs office     (the address and the one-time setup token)
# A new setup token, while nobody has set up The Office yet:
#   docker compose exec office npm run setup-token -- --quiet

# The Office's release to run: the image's tag. Each release's the-office.env comes with it set.
# To move to another release, change it and run `docker compose up -d --no-deps office`.
OFFICE_VERSION=

# The Office data folder (worktrees, sessions, skills, attachments); an absolute path, mounted at
# the same path in the container, since run environments mount worktrees by their path. Created at
# first start if missing, its top owned by uid 10001, the image's user `office`.
OFFICE_DATA_DIR=/var/lib/the-office

# The service's address and port, on the host's own network. 127.0.0.1 serves this machine alone.
# To reach The Office over the local network, name the machine's IP address or 0.0.0.0 (every
# address): passwords and the sign-in cookie then cross it over plain HTTP, so only on a network
# you trust. A request must be addressed to localhost, an IP address or the public address below,
# never another name.
OFFICE_HOST=127.0.0.1
OFFICE_PORT=4310

# The public address: the https:// address, with no path, at which your reverse proxy serves
# The Office, such as https://office.example.com. Left blank, The Office has none.
OFFICE_PUBLIC_ADDRESS=

# The group of the host's Docker socket, which The Office joins to start run environments:
# `stat -c %g /var/run/docker.sock`. Reaching the socket is reaching the host as root.
DOCKER_GID=

# The database's password, for Postgres and The Office alike; hex, so it needs no URL-encoding:
# `openssl rand -hex 24`. Postgres keeps the one it was first started with.
POSTGRES_PASSWORD=

# The port Postgres is published on, on 127.0.0.1 only.
POSTGRES_PORT=5432

# The bundled Grafana, grafana/otel-lgtm, at http://localhost:<GRAFANA_PORT>, started while
# COMPOSE_PROFILES holds grafana; choose "Bundled Grafana" in Settings › Telemetry then. Left
# blank, Compose starts The Office and Postgres alone.
COMPOSE_PROFILES=
GRAFANA_PORT=3300

# Set to true to leave out First-run setup's basics (the engine, Sign in with GitHub, telemetry);
# the setup token and the first user are still asked for.
OFFICE_SKIP_SETUP_BASICS=

# Another image than The Office's own, such as a fork's (ghcr.io/<owner>/the-office). Its tag is
# still OFFICE_VERSION.
# OFFICE_IMAGE=
