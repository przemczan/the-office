{
  "name": "the-office",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @the-office/service",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start --workspace @the-office/service",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run maps:check && npm run build && npm run test && npm run test:e2e && npm run service-start-check",
    "verify:full": "npm run typecheck && npm run lint && npm run format:check && npm run maps:check && npm run build && npm run test:full && npm run test:e2e:full && npm run service-start-check",
    "typecheck": "tsc -p . && npm run typecheck --workspaces --if-present",
    "lint": "oxlint",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css,yaml,yml}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css,yaml,yml}\"",
    "maps": "node tools/module-maps/src/main.ts",
    "maps:check": "node tools/module-maps/src/main.ts --check",
    "test": "vitest run --exclude \"**/*.full.test.*\" && npm run test:tools",
    "test:full": "vitest run && npm run test:tools",
    "test:tools": "npm run test --workspace tools --if-present",
    "test:e2e": "npm run test:e2e --workspace @the-office/web",
    "test:e2e:full": "npm run test:e2e:full --workspace @the-office/web",
    "service-start-check": "npm run check --workspace @the-office/service-start-check",
    "engine-check": "npm run check --workspace @the-office/engine-check --"
  },
  "engines": {
    "node": ">=22.18 <23"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
