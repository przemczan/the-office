{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // As vite.config.ts resolves them: workspace packages from their src/.
    "customConditions": ["source"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "noEmit": true,
    // packages/ui imports its own files with .ts, for Node to load its vite.ts.
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "e2e",
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "playwright.full.config.ts",
    "playwright.readme.config.ts"
  ]
}
