{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    // Inside dist/, so the build script's clean also clears what tsc -b remembers.
    "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
    "sourceMap": true
  },
  "include": ["src"],
  // Fixtures are test data kept beside the code they describe, shared by its tests.
  "exclude": ["src/**/*.test.ts", "src/**/*.fixtures.ts"],
  "references": [{ "path": "../../packages/contracts" }]
}
