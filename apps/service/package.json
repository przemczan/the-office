{
  "name": "@the-office/service",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b .",
    "build": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\" && tsc -b tsconfig.build.json",
    "dev": "npm run build && concurrently --kill-others --names build,service \"tsc -b tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch-path=dist --enable-source-maps --env-file-if-exists=../../.env dist/dev.js\"",
    "db:generate": "drizzle-kit generate",
    "start": "node --env-file-if-exists=../../.env ../../tools/office-launcher/src/main.ts",
    "set-password": "node --env-file-if-exists=../../.env dist/set-password.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.300.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/instrumentation-express": "0.72.0",
    "@opentelemetry/instrumentation-http": "0.300.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/sdk-logs": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/sdk-trace": "3.0.0",
    "@oslojs/encoding": "1.1.0",
    "@oslojs/otp": "1.1.0",
    "@simplewebauthn/server": "14.1.0",
    "@the-office/contracts": "*",
    "ajv": "8.20.0",
    "arctic": "3.7.0",
    "cross-spawn": "7.0.6",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "fractional-indexing": "4.0.0",
    "import-in-the-middle": "3.5.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "turndown": "7.2.4",
    "unpdf": "1.9.1",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@opentelemetry/context-async-hooks": "3.0.0",
    "@swc/core": "1.16.20",
    "@types/cross-spawn": "6.0.6",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/turndown": "5.0.6",
    "@types/ws": "8.18.2",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.5",
    "yazl": "3.3.1"
  }
}
